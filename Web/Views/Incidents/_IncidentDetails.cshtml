@using System.Web
@using ViewModels.Incident
@model IncidentViewModel


<div class="shadow-sm border border-gray-200 card-body InfoCard">
    <h6 class="fw-bold mb-3">Incident Details</h6>
    <div class="row">
        <div class="col-md-6 mb-3">
            <label class="form-label">Incident Type <span class="text-danger">*</span></label>
            <select class="form-select" id="eventTypeId" name="incidentDetails.EventTypeId" data-val="true" data-val-required="Incident Type is required.">
                <option value="">Select Incident Type</option>
                @foreach (var et in Model.incidentDetails.EventTypes)
                {
                    <option value="@et.Value" selected="@(et.Value == (Model.incidentDetails.EventTypeId?.ToString() ?? ""))">@et.Text</option>
                }
            </select>
        </div>

        <div class="col-md-6 mb-3">
            <label class="form-label">Incident Sub-Type <span class="text-danger">*</span></label>
            <select class="form-select" id="eventSubTypeId" name="incidentDetails.EventSubTypeId" data-val="true" data-val-required="Incident Sub-Type is required.">
                <option value="">Select Sub-Type</option>
                @foreach (var st in Model.incidentDetails.EventSubTypes)
                {
                    <option value="@st.Value" selected="@(st.Value == (Model.incidentDetails.EventSubTypeId?.ToString() ?? ""))">@st.Text</option>
                }
            </select>
        </div>

        <div class="col-md-12 mb-3">
            <label class="form-label">Impact Scope</label>
            @{
                var scope = (Model.incidentDetails.ImpactScope ?? string.Empty).ToLower();
            }
            <div class="d-flex flex-wrap gap-4">
                <div class="form-check">
                    <input class="form-check-input" type="radio" name="incidentDetails.ImpactScope" id="impactSingle" value="Single" checked="@(scope == "single")" />
                    <label class="form-check-label" for="impactSingle">Single customer</label>
                </div>
                <div class="form-check">
                    <input class="form-check-input" type="radio" name="incidentDetails.ImpactScope" id="impactMultiple" value="Multiple" checked="@(scope == "multiple")" />
                    <label class="form-check-label" for="impactMultiple">Multiple customers</label>
                </div>
                <div class="form-check">
                    <input class="form-check-input" type="radio" name="incidentDetails.ImpactScope" id="impactUnknown" value="Unknown" checked="@(scope == "unknown")" />
                    <label class="form-check-label" for="impactUnknown">Unknown</label>
                </div>
            </div>
        </div>



        <div class="d-flex justify-content-end gap-2 mt-3 addIncidentBtns">
            <button type="button" class="btn btnBack" id="backButtonToAdditionalLoc">Back</button>
            <button type="button" class="btn btn-primary" id="nextToDescriptionIssue">Next</button>
        </div>
    </div>
</div>