@using ViewModels.Incident
@model IncidentValidationLocationViewModel

<form id="incidentDetailsEditForm">
    <input type="hidden" name="IncidentId" value="@ViewBag.IncidentId" />
    <input type="hidden" name="IncidentValidationId" value="@ViewBag.IncidentValidationId" />
    
    <div class="row">
        <div class="col-md-6">
            <div class="form-group mb-3">
                <label>Severity Level <span style="color:red">*</span></label>
                <select class="form-select" name="SeverityLevelId" id="SeverityLevelId" required>
                    <option value="">Select Severity Level</option>
                    @foreach (var item in ViewBag.SeverityLevels as List<Microsoft.AspNetCore.Mvc.Rendering.SelectListItem>)
                    {
                        <option value="@item.Value" selected="@(item.Value == Model.SeverityID?.ToString())">@item.Text</option>
                    }
                </select>
            </div>
        </div>
        <div class="col-md-6">
            <div class="form-group mb-3">
                <label>Discovery Perimeter <span style="color:red">*</span></label>
                <select class="form-select" name="DiscoveryPerimeterId" id="DiscoveryPerimeterId" required>
                    <option value="">Select Discovery Perimeter</option>
                    <option value="1" selected="@(Model.DiscoveryPerimeter == 1)">1 Mile</option>
                    <option value="2" selected="@(Model.DiscoveryPerimeter == 2)">3 Miles</option>
                    <option value="3" selected="@(Model.DiscoveryPerimeter == 3)">5 Miles</option>
                </select>
            </div>
        </div>
    </div>
    <div class="row">
        <div class="col-md-12">
            <div class="form-group mb-3">
                <label>ICP Location</label>
                <input type="text" class="form-control" name="ICPLocation" id="ICPLocationEdit" value="@Model.ICPLocation" placeholder="123 Main St, City, ST 12345" />
                <ul id="suggestionsICPLocationEdit" class="suggestions-list"></ul>
            </div>
        </div>
    </div>
</form>

