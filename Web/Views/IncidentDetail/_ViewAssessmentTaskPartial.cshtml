@model ViewModels.Incident.IncidentEditTaskListViewModel

<div class="modal fade" id="viewIncidentAssessmentTaskModal" tabindex="-1" aria-labelledby="viewIncidentAssessmentTaskModallabel" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="viewIncidentAssessmentTaskModallabel">View Incident Assessment Task</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <form>
                    <input type="hidden" value="@Model.Id" />
                    <div class="row">
                        <div class="col-md-6">
                            <div class="form-group d-flex align-items-center">
                                <label class="form-label">Task</label>
                                <label>: <b>@Model.Task</b></label>
                            </div>
                            <div class="form-group d-flex align-items-center ">
                                <label class="form-label">Status</label>
                                <label>: <b>@Model.StatusName</b></label>
                            </div>
                            <div class="form-group">
                                <label class="form-label">Description</label>
                                <label><b>@Model.Description</b></label>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-group d-flex align-items-center">
                                <label class="form-label">Roles</label>
                                <label>: <b>@Model.RoleName</b></label>
                            </div>
                            <div class="form-group">
                                <label class="form-label">Evidence</label>
                                @if (!string.IsNullOrWhiteSpace(Model.ImageUrl))
                                {
                                    var imgList = Model.ImageUrl.Split(",", StringSplitOptions.RemoveEmptyEntries)
                                        .Select(img => img.Trim())
                                        .ToList();

                                    foreach (var item in imgList)
                                    {
                                        <img src="@item" alt="" style="width: 75px;height: 75px;" />
                                    }
                                }
                                else
                                {
                                    <div>No evidence provided.</div>
                                }
                            </div>
                        </div>
                    </div>
                </form>
            </div>
            <div class="modal-footer d-flex justify-content-end">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                    <i class="fas fa-times"></i> Cancel
                </button>
            </div>
        </div>
    </div>
</div>

