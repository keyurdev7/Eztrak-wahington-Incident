@model ViewModels.Incident.IncidentEditTaskListViewModel
@{
    var completeStatusId = Model.StatusList?.FirstOrDefault(s => string.Equals((s.Text ?? string.Empty).Trim(), "Complete", StringComparison.OrdinalIgnoreCase))?.Value ?? "";
    var naStatusId = Model.StatusList?.FirstOrDefault(s => string.Equals((s.Text ?? string.Empty).Trim(), "N/A", StringComparison.OrdinalIgnoreCase) || string.Equals((s.Text ?? string.Empty).Trim(), "NA", StringComparison.OrdinalIgnoreCase))?.Value ?? "";
}

<div class="modal fade" id="updateIncidentRepairModal" tabindex="-1" aria-labelledby="updateRepairTaskModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="updateRepairTaskModalLabel">Update Repair Task</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <form id="UpdateRepairTaskForm">
                    <input type="hidden" id="repairTaskId" value="@Model.Id" />
                    <input type="hidden" id="repairIncidentId" value="@Model.IncidentId" />
                    <input type="hidden" id="repairIncidentValidationId" value="@Model.IncidentValidationId" />
                    <div class="row">
                        <div class="col-md-6">
                            <div class="form-group">
                                <label class="form-label">Task</label>
                                <textarea class="form-control" id="repairTask" rows="3" asp-for="@Model.Task" readonly></textarea>
                            </div>
                            <div class="form-group">
                                <label class="form-label">Status</label>
                                <div class="d-flex gap-4 align-items-center py-1">
                                    <div class="form-check mb-0">
                                        <input class="form-check-input" type="radio" name="repairStatusAction" id="repairMarkComplete" value="@completeStatusId">
                                        <label class="form-check-label" for="repairMarkComplete">Mark Complete</label>
                                    </div>
                                    <div class="form-check mb-0">
                                        <input class="form-check-input" type="radio" name="repairStatusAction" id="repairMarkNa" value="@naStatusId">
                                        <label class="form-check-label" for="repairMarkNa">Mark N/A</label>
                                    </div>
                                </div>
                            </div>
                            <div class="form-group">
                                <label class="form-label">Notes</label>
                                <textarea class="form-control" id="repairDescription" rows="3" asp-for="@Model.Description" readonly></textarea>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-group mb-3" id="div_UpdateRepairRole">
                                <input type="hidden" id="hdn_UpdateRepairRole" asp-for="@Model.RoleIds" name="RoleIds" />
                                <label>Responsible Role (Multiple)</label>
                                <input type="text" class="form-control" value="@Model.RoleName" readonly />
                            </div>
                            <div class="form-group">
                                <label class="form-label">Evidence</label>
                                <input type="hidden" id="repair_hdnImgUrl" value="@Model.ImageUrl" />
                                <input type="file" id="fileInputRepairTask" multiple class="file-upload" asp-for="@Model.File">
                                <div id="previewContainerRepairTask" class="d-flex flex-wrap gap-2"></div>
                            </div>
                        </div>
                    </div>
                </form>
            </div>
            <div class="modal-footer d-flex justify-content-end">
                <button type="submit" class="btn btn-success" id="btnUpdateRepairTask">
                    <i class="fas fa-check"></i> Update
                </button>
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                    <i class="fas fa-times"></i> Cancel
                </button>
            </div>
        </div>
    </div>
</div>

<script>
    $(document).ready(function () {
        $(document).off("click", "#btnUpdateRepairTask");
        $(document).on("click", "#btnUpdateRepairTask", async function (e) {
            e.preventDefault();
            await submitRepairTaskUpdate();
        });
    });

    async function submitRepairTaskUpdate() {
        try {
            showLoader($("#updateIncidentRepairModal"));

            const selectedStatus = document.querySelector('input[name="repairStatusAction"]:checked');
            if (!selectedStatus || !selectedStatus.value) {
                SwalErrorAlert("Please select a status action: Mark Complete or Mark N/A.");
                return;
            }

            const formData = new FormData();
            formData.append("Id", document.getElementById("repairTaskId").value);
            formData.append("IncidentId", document.getElementById("repairIncidentId").value);
            formData.append("IncidentValidationId", document.getElementById("repairIncidentValidationId").value);
            formData.append("Task", document.getElementById("repairTask").value);
            formData.append("StatusId", selectedStatus.value);
            formData.append("RoleIds", document.getElementById("hdn_UpdateRepairRole").value);
            formData.append("Description", document.getElementById("repairDescription").value);
            formData.append("ImageUrl", document.getElementById("repair_hdnImgUrl").value);

            const files = document.getElementById("fileInputRepairTask").files;
            for (let i = 0; i < files.length; i++) {
                formData.append("Files", files[i]);
            }

            const response = await fetch("/IncidentDetail/UpdateRepairTask", {
                method: "POST",
                body: formData
            });

            if (!response.ok) throw new Error("Failed to update repair task");

            const result = await response.json();
            if (result.success) {
                SwalSuccessAlert("Updated Successfully");
                $("#updateIncidentRepairModal").modal("hide");
                GetRepairDetails();
            } else {
                SwalErrorAlert(result.message || "Update failed.");
            }
        } catch (error) {
            console.error("Error updating repair task:", error);
            SwalErrorAlert("Update failed.");
        } finally {
            hideLoader($("#updateIncidentRepairModal"));
        }
    }
</script>

