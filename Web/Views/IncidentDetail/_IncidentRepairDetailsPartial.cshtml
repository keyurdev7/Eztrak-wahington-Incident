@using System.Web
@using System.IO
@using ViewModels.Incident
@model IncidentViewTaskViewModel
@{
    string GetFileTypeIcon(string imageUrl)
    {
        if (string.IsNullOrWhiteSpace(imageUrl)) return "fa-file-alt text-muted";
        var fileExtensions = imageUrl.Split(',', StringSplitOptions.RemoveEmptyEntries)
            .Select(u => System.IO.Path.GetExtension(u.Trim()).ToLower()).ToList();
        if (fileExtensions.Count == 0) return "fa-file-alt text-muted";
        var imageExts = new[] { ".jpg", ".jpeg", ".png", ".gif", ".bmp", ".webp", ".svg" };
        var docExts = new[] { ".doc", ".docx", ".xls", ".xlsx", ".ppt", ".pptx", ".txt", ".rtf" };
        if (fileExtensions.Count(ext => imageExts.Contains(ext)) > 0) return "fa-file-image text-success";
        if (fileExtensions.Count(ext => ext == ".pdf") > 0) return "fa-file-pdf text-danger";
        if (fileExtensions.Count(ext => docExts.Contains(ext)) > 0) return "fa-file-word text-primary";
        return "fa-file-alt text-secondary";
    }
}

@if (Model != null)
{
    <div class="card mb-4">
        <div class="card-body p-0">
            <div class="d-flex justify-content-between align-items-center mb-0 p-3">
                <h6 class="fw-bold mb-0">Pre-Operation Setup</h6>
                <button type="button" class="btn btn-add" onclick="OpenAddRepairTaskModal()">
                    <i class="fa-solid fa-plus me-2"></i>Add Task
                </button>
            </div>
            <div class="table-responsive table-rounded custom-scroll">
                <table id="repairTable" class="table align-middle text-left" style="table-layout: fixed;">
                    <thead class="table-light">
                        <tr>
                            <th style="width: 40%;">Task</th>
                            <th style="width: 40%;">Responsible Party</th>
                            <th style="width: 10%;">Status</th>
                            <th style="width: 10%;">Evidence</th>
                        </tr>
                    </thead>
                    <tbody ondragover="dragOver(event)" ondrop="drop(event)">
                        @if (Model.listIncidentViewTaskViewModel != null && Model.listIncidentViewTaskViewModel.Any())
                        {
                            foreach (var task in Model.listIncidentViewTaskViewModel)
                            {
                                <tr draggable="true" data-id="@task.Id" ondragstart="dragStart(event)">
                                    <td>@task.Task</td>
                                    <td>@(string.IsNullOrWhiteSpace(task.FieldValue) ? "—" : task.FieldValue)</td>
                                    <td>
                                        <a href="#" onclick="EditRepairTask('@task.Id')">
                                            @if (!string.IsNullOrWhiteSpace(task.Status))
                                            {
                                                if (task.Status.ToLower() == "started")
                                                {
                                                    <span class="status-badge progressing">@task.Status</span>
                                                }
                                                else if (task.Status.ToLower() == "not started")
                                                {
                                                    <span class="status-badge not-started">@task.Status</span>
                                                }
                                                else if (task.Status.ToLower() == "complete")
                                                {
                                                    <span class="status-badge done">@task.Status</span>
                                                }
                                                else
                                                {
                                                    <span class="status-badge not-started">@task.Status</span>
                                                }
                                            }
                                            else
                                            {
                                                <span class="status-badge not-started">Not Started</span>
                                            }
                                        </a>
                                    </td>
                                    <td>
                                        @if (task.ImageCount > 0)
                                        {
                                            <a href="#" onclick="ViewRepairTask('@task.Id')">
                                                <i class="fa @GetFileTypeIcon(task.ImagesUrl ?? "") me-1"></i>@(task.ImageCount) @("file")
                                            </a>
                                        }
                                        else
                                        {
                                            <span>--</span>
                                        }
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr><td colspan="4" class="text-center">No tasks found</td></tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
}
else
{
    <div class="card mb-4">
        <div class="card-body p-0">
            <div class="d-flex justify-content-between align-items-center mb-0 p-3">
                <h6 class="fw-bold mb-0">Pre-Operation Setup</h6>
                <button type="button" class="btn btn-add" onclick="OpenAddRepairTaskModal()">
                    <i class="fa-solid fa-plus me-2"></i>Add Task
                </button>
            </div>
            <div class="table-responsive table-rounded custom-scroll">
                <table id="repairTable" class="table align-middle text-left" style="table-layout: fixed;">
                    <thead class="table-light">
                        <tr>
                            <th style="width: 40%;">Task</th>
                            <th style="width: 40%;">Responsible Party</th>
                            <th style="width: 10%;">Status</th>
                            <th style="width: 10%;">Evidence</th>
                        </tr>
                    </thead>
                    <tbody ondragover="dragOver(event)" ondrop="drop(event)"><tr><td colspan="4" class="text-center">No tasks found</td></tr></tbody>
                </table>
            </div>
        </div>
    </div>
}
