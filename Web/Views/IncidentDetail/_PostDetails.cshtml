                                <div class="update-message note-message-box">@post.Message</div>
                                @if (!string.IsNullOrWhiteSpace(post.AttachmentUrls))
                                {
                                    <div class="note-attachments mt-1">
                                        @foreach (var file in post.AttachmentUrls.Split(',', StringSplitOptions.RemoveEmptyEntries))
                                        {
                                            var fileUrl = file.Trim();
                                            if (IsImageFile(fileUrl))
                                            {
                                                <a href="@fileUrl" target="_blank" class="note-image-link" title="@System.IO.Path.GetFileName(fileUrl)">
                                                    <img src="@fileUrl" alt="@System.IO.Path.GetFileName(fileUrl)" class="note-image-thumb" />
                                                </a>
                                            }
                                            else
                                            {
                                                <a href="@fileUrl" target="_blank" class="d-block text-decoration-none small note-file-link">
                                                    <i class="fa-solid fa-paperclip me-1"></i>@System.IO.Path.GetFileName(fileUrl)
                                                </a>
                                            }
                                        }
                                    </div>
                                }
                                <div class="update-meta">
                                    <span class="update-time">@post.TimeforMessage</span>
                                    <span class="update-email postby-div">admin@eztrak.com</span>
                                </div>
                            </div>
                        }
                    }
