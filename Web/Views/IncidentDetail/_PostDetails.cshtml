                                    Model.IncidentViewRepairViewModel.listIncidentViewPostViewModel.Any())
                    {
                        @foreach (var post in Model.IncidentViewRepairViewModel.listIncidentViewPostViewModel.OrderByDescending(x => x.Id))
                        {
