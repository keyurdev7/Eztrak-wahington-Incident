@using System.Web
@using System.IO
@using ViewModels.Incident
@model IncidentAssessmentDetailViewModel
@{
    string GetFileTypeIcon(string imageUrl)
    {
        if (string.IsNullOrWhiteSpace(imageUrl)) return "fa-file-alt text-muted";
        var fileExtensions = imageUrl.Split(',', StringSplitOptions.RemoveEmptyEntries)
            .Select(u => System.IO.Path.GetExtension(u.Trim()).ToLower()).ToList();
        if (fileExtensions.Count == 0) return "fa-file-alt text-muted";
        var imageExts = new[] { ".jpg", ".jpeg", ".png", ".gif", ".bmp", ".webp", ".svg" };
        var docExts = new[] { ".doc", ".docx", ".xls", ".xlsx", ".ppt", ".pptx", ".txt", ".rtf" };
        if (fileExtensions.Count(ext => imageExts.Contains(ext)) > 0) return "fa-file-image text-success";
        if (fileExtensions.Count(ext => ext == ".pdf") > 0) return "fa-file-pdf text-danger";
        if (fileExtensions.Count(ext => docExts.Contains(ext)) > 0) return "fa-file-word text-primary";
        return "fa-file-alt text-secondary";
    }
}

@if (Model != null)
{
    <div class="card mb-4">
        <div class="card-body p-0">
            <div class="status-legend checklist-status-legend px-3 pt-3 pb-2">
                <span class="legend-item">
                    <span class="status-dot status-dot-complete"></span>
                    Complete
                </span>
                <span class="legend-item">
                    <span class="status-dot status-dot-incomplete"></span>
                    Incomplete
                </span>
                <span class="legend-item">
                    <span class="status-dot status-dot-na"></span>
                    N/A
                </span>
            </div>
            <div class="table-responsive table-rounded custom-scroll">
                <table id="assessmentTable" class="table align-middle text-left checklist-table">
                    <thead class="table-light">
                        <tr>
                            <th style="width: 100px;">Status</th>
                            <th style="width: 220px;">Party</th>
                            <th style="width: 340px;">Task</th>
                            <th style="width: 110px;">Evidence</th>
                            <th style="width: 170px;">Last Updated</th>
                            <th style="width: 170px;">Updated By</th>
                            <th style="width: 220px;">Actions</th>
                        </tr>
                    </thead>
                    <tbody ondragover="dragOver(event)" ondrop="drop(event)">
                        @if (Model.AssessmentTasks != null && Model.AssessmentTasks.Any())
                        {
                            foreach (var task in Model.AssessmentTasks)
                            {
                                var statusText = string.IsNullOrWhiteSpace(task.Status) ? "Not Started" : task.Status;
                                var statusLower = statusText.Trim().ToLowerInvariant();
                                var dotClass = statusLower == "complete"
                                    ? "status-dot-complete"
                                    : (statusLower == "n/a" || statusLower == "na")
                                        ? "status-dot-na"
                                        : "status-dot-incomplete";
                                <tr draggable="true" data-id="@task.Id" ondragstart="dragStart(event)">
                                    <td>
                                        <span class="status-cell">
                                            <span class="status-dot @dotClass"></span>
                                            <span class="status-text d-none">@statusText</span>
                                        </span>
                                    </td>
                                    <td>@(string.IsNullOrWhiteSpace(task.FieldValue) ? "—" : task.FieldValue)</td>
                                    <td>@(task.Task ?? "")</td>
                                    <td>
                                        @if (task.ImageCount > 0)
                                        {
                                            <a href="#" onclick="ViewAssessmentTask('@task.Id'); return false;" class="text-decoration-none">
                                                <i class="fa @GetFileTypeIcon(task.ImagesUrl ?? "") me-1"></i>@(task.ImageCount) file
                                            </a>
                                        }
                                        else
                                        {
                                            <span>--</span>
                                        }
                                    </td>
                                    <td>@(!string.IsNullOrWhiteSpace(task.LastUpdated) ? task.LastUpdated : "--")</td>
                                    <td>@(!string.IsNullOrWhiteSpace(task.UpdatedBy) ? task.UpdatedBy : "--")</td>
                                    <td>
                                        <div class="checklist-actions">
                                            <button type="button" class="btn btn-sm btn-outline-secondary" title="Edit" aria-label="Edit" onclick="EditAssessmentTask('@task.Id'); return false;">
                                                <i class="fa-solid fa-pen"></i>
                                            </button>
                                            <button type="button" class="btn btn-sm btn-outline-info" title="History" aria-label="History" onclick="ViewAssessmentTask('@task.Id'); return false;">
                                                <i class="fas fa-history"></i>
                                            </button>
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr><td colspan="7" class="text-center">No tasks found</td></tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
}
else
{
    <div class="card mb-4">
        <div class="card-body p-0">
            <div class="table-responsive table-rounded custom-scroll">
                <table id="assessmentTable" class="table align-middle text-left checklist-table">
                    <thead class="table-light">
                        <tr>
                            <th style="width: 100px;">Status</th>
                            <th style="width: 220px;">Party</th>
                            <th style="width: 340px;">Task</th>
                            <th style="width: 110px;">Evidence</th>
                            <th style="width: 170px;">Last Updated</th>
                            <th style="width: 170px;">Updated By</th>
                            <th style="width: 220px;">Actions</th>
                        </tr>
                    </thead>
                    <tbody ondragover="dragOver(event)" ondrop="drop(event)"><tr><td colspan="7" class="text-center">No tasks found</td></tr></tbody>
                </table>
            </div>
        </div>
    </div>
}
