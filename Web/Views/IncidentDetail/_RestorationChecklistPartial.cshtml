@using ViewModels.Incident
@using System.IO
@model IncidentViewTaskViewModel
@{
    // Helper function to get file type icon based on file extension
    // Handles multiple file types by prioritizing: images > PDFs > documents > generic
    string GetFileTypeIcon(string imageUrl)
    {
        if (string.IsNullOrWhiteSpace(imageUrl))
            return "fa-file-alt text-muted";

        var fileExtensions = imageUrl.Split(',', StringSplitOptions.RemoveEmptyEntries)
            .Select(u => System.IO.Path.GetExtension(u.Trim()).ToLower())
            .ToList();

        if (fileExtensions.Count == 0)
            return "fa-file-alt text-muted";

        // Define file type categories
        var imageExts = new[] { ".jpg", ".jpeg", ".png", ".gif", ".bmp", ".webp", ".svg" };
        var docExts = new[] { ".doc", ".docx", ".xls", ".xlsx", ".ppt", ".pptx", ".txt", ".rtf" };

        // Count file types
        var imageCount = fileExtensions.Count(ext => imageExts.Contains(ext));
        var pdfCount = fileExtensions.Count(ext => ext == ".pdf");
        var docCount = fileExtensions.Count(ext => docExts.Contains(ext));

        // Prioritize: if there are any images, show image icon
        if (imageCount > 0)
            return "fa-file-image text-success";

        // If there are any PDFs, show PDF icon
        if (pdfCount > 0)
            return "fa-file-pdf text-danger";

        // If there are any documents, show document icon
        if (docCount > 0)
            return "fa-file-word text-primary";

        // Default to generic file icon
        return "fa-file-alt text-secondary";
    }
}

@{
    var restorationTasks = Model?.listIncidentViewTaskViewModel ?? new List<IncidentViewTaskListViewModel>();
    var restorationOwners = restorationTasks
        .Select(t => t.FieldValue)
        .Where(v => !string.IsNullOrWhiteSpace(v) && v.Trim() != "—")
        .Distinct()
        .OrderBy(v => v)
        .ToList();

    var restorationStatuses = restorationTasks
        .Select(t => string.IsNullOrWhiteSpace(t.Status) ? "Not Started" : t.Status)
        .Where(v => !string.IsNullOrWhiteSpace(v))
        .Distinct()
        .OrderBy(v => v)
        .ToList();
}

<div class="card mb-4">
    <div class="card-body p-0">
        <div class="d-flex align-items-center justify-content-between mb-0 p-3">
            <h6 class="fw-bold mb-0">Restoration Checklist</h6>
        </div>

        <div class="checklist-toolbar w-100 p-3">
            <div class="checklist-toolbar-left d-flex align-items-center justify-content-start flex-wrap gap-2">
                <input type="text" class="form-control" id="restoration_global_search_value" placeholder="Search steps..." style="max-width:180px;">

                <select class="form-select" style="max-width:150px;" id="restoration_ddlOwner">
                    <option value="">All owners</option>
                    @foreach (var owner in restorationOwners)
                    {
                        <option value="@owner">@owner</option>
                    }
                </select>

                <select class="form-select" style="max-width:150px;" id="restoration_ddlStatus">
                    <option value="">Status: All</option>
                    @foreach (var st in restorationStatuses)
                    {
                        <option value="@st">@st</option>
                    }
                </select>

            </div>
            <div class="checklist-toolbar-right d-flex align-items-center gap-2">
                <div class="filter-link">Filter</div>
                <button type="button" class="btn btn-add" onclick="OpenAddTaskModal()">
                    <i class="fa-solid fa-plus me-2"></i>Add Task
                </button>
            </div>
        </div>

        <div class="status-legend checklist-status-legend px-3 pt-0 pb-2">
            <span class="legend-item">
                <span class="status-dot status-dot-complete"></span>
                Complete
            </span>
            <span class="legend-item">
                <span class="status-dot status-dot-incomplete"></span>
                Incomplete
            </span>
            <span class="legend-item">
                <span class="status-dot status-dot-na"></span>
                N/A
            </span>
        </div>

        <div class="table-responsive table-rounded custom-scroll">
            <table id="restorationTable" class="table align-middle text-left checklist-table">
                <thead class="table-light">
                    <tr>
                        <th style="width: 100px;">Status</th>
                        <th style="width: 220px;">Party</th>
                        <th style="width: 340px;">Task</th>
                        <th style="width: 110px;">Evidence</th>
                        <th style="width: 170px;">Last Updated</th>
                        <th style="width: 170px;">Updated By</th>
                        <th style="width: 220px;">Actions</th>
                    </tr>
                </thead>
                <tbody ondragover="dragOver(event)" ondrop="drop(event)">
                    @if (restorationTasks != null && restorationTasks.Any())
                    {
                        foreach (var task in restorationTasks)
                        {
                            var statusText = string.IsNullOrWhiteSpace(task.Status) ? "Not Started" : task.Status;
                            var statusLower = statusText.Trim().ToLowerInvariant();
                            var dotClass = statusLower == "complete"
                                ? "status-dot-complete"
                                : (statusLower == "n/a" || statusLower == "na")
                                    ? "status-dot-na"
                                    : "status-dot-incomplete";
                            <tr draggable="true" data-id="@task.Id" ondragstart="dragStart(event)">
                                <td>
                                    <span class="status-cell">
                                        <span class="status-dot @dotClass"></span>
                                        <span class="status-text d-none">@statusText</span>
                                    </span>
                                </td>
                                <td>@(string.IsNullOrWhiteSpace(task.FieldValue) ? "—" : task.FieldValue)</td>

                                @if (!string.IsNullOrWhiteSpace(task.Status))
                                {
                                    @if (task.Status.ToLower() == "started")
                                    {
                                        <td>
                                            <span>
                                                <span>@(task.Task ?? "")</span>
                                            </span>
                                        </td>
                                    }
                                    else if (task.Status.ToLower() == "not started")
                                    {
                                        <td>
                                            <span>
                                                <span>@(task.Task ?? "")</span>
                                            </span>
                                        </td>
                                    }
                                    else if (task.Status.ToLower() == "complete")
                                    {
                                        <td>

                                            <span>@(task.Task ?? "")</span>
                                            
                                        </td>
                                    }
                                    else
                                    {
                                        <td>
                                            <span>
                                                <span>@(task.Task ?? "")</span>
                                            </span>
                                        </td>
                                    }
                                }
                                else
                                {
                                    <td>
                                        <span>
                                            <span>@(task.Task ?? "")</span>
                                        </span>
                                    </td>
                                }


                              @*   <td>@(string.IsNullOrWhiteSpace(task.Started) ? "—" : task.Started)</td>
                                <td>@(string.IsNullOrWhiteSpace(task.Completed) ? "—" : task.Completed)</td> *@

                                @if (task.ImageCount > 0)
                                {
                                    <td>
                                        <a href="#" onclick="ViewRestorationDetails('@task.Id')" class="text-decoration-none">
                                            <i class="fa @GetFileTypeIcon(task.ImagesUrl ?? "") me-1"></i>@(task.ImageCount) @("file")
                                        </a>
                                    </td>
                                }
                                else
                                {
                                    <td><span>--</span></td>
                                }

                                <td>@(!string.IsNullOrWhiteSpace(task.LastUpdated) ? task.LastUpdated : "--")</td>
                                <td>@(!string.IsNullOrWhiteSpace(task.UpdatedBy) ? task.UpdatedBy : "--")</td>
                                <td>
                                    <div class="checklist-actions">
                                        <button type="button" class="btn btn-sm btn-outline-secondary" title="Edit" aria-label="Edit" onclick="EditRestorationDetails('@task.Id'); return false;">
                                            <i class="fa-solid fa-pen"></i>
                                        </button>
                                        <button type="button" class="btn btn-sm btn-outline-info" title="History" aria-label="History" onclick="ViewRestorationDetails('@task.Id'); return false;">
                                            <i class="fas fa-history"></i>
                                        </button>
                                    </div>
                                </td>

                              @*   @if (!string.IsNullOrWhiteSpace(task.Status) && task.Status == "Complete")
                                {
                                    <td><a href="#" class="text-primary text-decoration-none" onclick="ViewRestorationDetails('@task.Id')">View</a></td>
                                }
                                else
                                {
                                    <td><button class="btn btn-update btn-sm" onclick="EditRestorationDetails('@task.Id')">Update</button></td>
                                } *@
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="7" class="text-center">No tasks found</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<script>
    (function () {
        function applyRestorationFilters() {
            var q = ($('#restoration_global_search_value').val() || '').toString().trim().toLowerCase();
            var owner = $('#restoration_ddlOwner').val();
            var status = $('#restoration_ddlStatus').val();

            $('#restorationTable tbody tr').each(function () {
                var $row = $(this);
                var statusText = $row.find('td:nth-child(1) .status-text').text().trim();
                var ownerText = $row.find('td:nth-child(2)').text().trim();
                var taskText = $row.find('td:nth-child(3)').text().trim().toLowerCase();

                var ok = true;
                if (q) ok = ok && taskText.indexOf(q) !== -1;
                if (owner) ok = ok && ownerText === owner;
                if (status) ok = ok && statusText === status;

                $row.toggle(ok);
            });
        }

        $(document)
            .off('input.restorationFilter', '#restoration_global_search_value')
            .on('input.restorationFilter', '#restoration_global_search_value', applyRestorationFilters);

        $(document)
            .off('change.restorationFilter', '#restoration_ddlOwner, #restoration_ddlStatus')
            .on('change.restorationFilter', '#restoration_ddlOwner, #restoration_ddlStatus', applyRestorationFilters);

        applyRestorationFilters();
    })();
</script>
