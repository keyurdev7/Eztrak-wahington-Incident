@using ViewModels.Incident
@using Microsoft.AspNetCore.Mvc.Rendering
@model AdditionalLocationViewModel

@{
    var selectedAssetIds = (Model.AssetIDs ?? string.Empty)
        .Split(',', StringSplitOptions.RemoveEmptyEntries)
        .Select(s => s.Trim())
        .ToHashSet(StringComparer.OrdinalIgnoreCase);

    var photos = (Model.VerificationPhotoUrl ?? string.Empty)
        .Split('|', StringSplitOptions.RemoveEmptyEntries)
        .Select(s => s.Trim())
        .Where(s => !string.IsNullOrWhiteSpace(s))
        .ToList();
}

<div class="modal fade" id="verifyLocationModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Verify Location</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <input type="hidden" id="verificationLocationId" value="@Model.Id" />
                <input type="hidden" id="verificationIncidentId" value="@Model.IncidentId" />

                <div class="mb-3">
                    <label class="form-label">Address</label>
                    <div class="form-control" style="height:auto;">@Model.LocationAddress</div>
                </div>

                <div class="row">
                    <div class="col-md-4 mb-3">
                        <label class="form-label">Status</label>
                        <select class="form-select" id="verificationStatus">
                            <option value="Pending" selected="@(string.IsNullOrWhiteSpace(Model.VerificationStatus) || Model.VerificationStatus == "Pending")">Pending</option>
                            <option value="Verified" selected="@(Model.VerificationStatus == "Verified")">Verified</option>
                            <option value="Rejected" selected="@(Model.VerificationStatus == "Rejected")">Rejected</option>
                        </select>
                    </div>
                    <div class="col-md-4 mb-3">
                        <label class="form-label">Latitude</label>
                        <input class="form-control" value="@Model.Latitude" disabled />
                    </div>
                    <div class="col-md-4 mb-3">
                        <label class="form-label">Longitude</label>
                        <input class="form-control" value="@Model.Longitude" disabled />
                    </div>
                </div>

                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label class="form-label">Service Account</label>
                        <input type="text" class="form-control" id="verificationServiceAccount" value="@Model.ServiceAccount" />
                    </div>
                    <div class="col-md-6 mb-3">
                        <label class="form-label">Asset Type(s)</label>
                        <select class="form-select" id="verificationAssetIds" multiple size="6">
                            @foreach (var a in Model.AssetsIncidentList ?? new List<SelectListItem>())
                            {
                                var isSelected = selectedAssetIds.Contains(a.Value ?? "");
                                <option value="@a.Value" selected="@(isSelected ? "selected" : null)">@a.Text</option>
                            }
                        </select>
                        <div class="form-text">Hold Ctrl/Command to select multiple.</div>
                    </div>
                </div>

                <div class="mb-3">
                    <label class="form-label">Notes</label>
                    <textarea class="form-control" id="verificationNotes" rows="3">@Model.VerificationNotes</textarea>
                </div>

                <div class="mb-3">
                    <label class="form-label">Photo(s)</label>
                    <input type="file" class="form-control" id="verificationFiles" multiple accept="image/*" />
                </div>

                @if (photos.Count > 0)
                {
                    <div class="mb-2 fw-semibold">Existing Photos</div>
                    <div class="d-flex flex-wrap gap-2">
                        @foreach (var p in photos)
                        {
                            <a href="@p" target="_blank">
                                <img src="@p" style="width:80px;height:80px;object-fit:cover;border:1px solid #ddd;border-radius:6px;" />
                            </a>
                        }
                    </div>
                }
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
                <button type="button" class="btn btn-primary" id="btnUpdateVerificationLocation">Submit</button>
            </div>
        </div>
    </div>
</div>

