@using ViewModels.EventSubType
@model List<EventSubTypeModifyViewModel>

@if (Model != null && Model.Count > 0)
{
    @foreach (var item in Model)
    {
        <div class="list-item">
            <div class="item-info">
                <strong>@item.Name</strong>
                <p class="mb-0 text-muted small">Incident Type: @item.EventTypeName</p>
                @if (!string.IsNullOrWhiteSpace(item.Description))
                {
                    <p class="mb-0">@item.Description</p>
                }
            </div>
            <div class="actions">
                <i class="fa-regular fa-edit edit editEventSubType" id="@item.Id"></i>
                <i class="far fa-trash-alt delete deleteEventSubType" id="@item.Id"></i>
            </div>
        </div>
    }
}
else
{
    <div class="list-item">
        <span>No sub-type found.</span>
    </div>
}

