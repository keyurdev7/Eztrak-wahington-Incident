@using ViewModels.EventSubType
@model EventSubTypeModifyViewModel

@{
    var types = ViewBag.EventTypes as List<ViewModels.EventTypeModifyViewModel> ?? new();
}

<form id="NewEventSubTypeForm">
    <input type="hidden" name="Id" value="@Model.Id" />

    <div class="row">
        <div class="col-md-6 mb-3">
            <label class="form-label">Incident Type</label>
            <select class="form-select" name="EventTypeId">
                <option value="">Select Incident Type</option>
                @foreach (var t in types)
                {
                    <option value="@t.Id" selected="@(t.Id == Model.EventTypeId)">@t.Name</option>
                }
            </select>
        </div>
        <div class="col-md-6 mb-3">
            <label class="form-label">Sub-Type Name</label>
            <input class="form-control" name="Name" value="@Model.Name" />
        </div>
    </div>

    <div class="mb-3">
        <label class="form-label">Description</label>
        <textarea class="form-control" name="Description" rows="2">@Model.Description</textarea>
    </div>

    <div class="d-flex justify-content-end gap-2">
        <button type="button" class="btn btn-secondary" id="btnCancelEventSubType">Cancel</button>
        <button type="button" class="btn btn-primary" id="btnSaveEventSubType">Save</button>
    </div>
</form>

