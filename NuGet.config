<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!--
    Local override to allow installing dotnet-ef tooling when Package Source Mapping is enabled.
    This should not affect existing package restores because it only adds an explicit mapping for dotnet-ef.
  -->
  <packageSources>
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>

  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="dotnet-ef" />
    </packageSource>
  </packageSourceMapping>
</configuration>

